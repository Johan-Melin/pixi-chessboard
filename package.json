{
  "name": "pixi-chessboard",
  "private": true,
  "version": "0.1.0",
  "description": "An animated, application-controlled chessboard renderer for PixiJS.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {"types":"./dist/index.d.ts","import":"./dist/index.js"},
    "./assets/retro-chess-assets.png": "./assets/retro-chess-assets.png",
    "./assets/pawn-white.svg": "./assets/pawn-white.svg",
    "./assets/pawn-black.svg": "./assets/pawn-black.svg",
    "./assets/pawn-original.svg": "./assets/pawn-original.svg",
    "./assets/pawn.svg": "./assets/pawn.svg",
    "./assets/rook.svg": "./assets/rook.svg",
    "./assets/knight.svg": "./assets/knight.svg",
    "./assets/bishop.svg": "./assets/bishop.svg"
  },
  "files": ["dist", "assets", "README.md"],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --mode library && tsc -p tsconfig.lib.json",
    "build:playground": "vite build",
    "prepack": "npm run build",
    "test": "playwright test"
  },
  "peerDependencies": {"pixi.js":"^8.0.0"},
  "devDependencies": {"pixi.js":"^8.0.0","typescript":"^5.0.0","vite":"^7.0.0","@playwright/test":"^1.62.1"}
}
